# Optional. Enables the "Ask" button (generated, cited answers). Retrieval and MCP work without it.
# Only ":free" OpenRouter models are ever called — the client throws on any other model id.
OPENROUTER_API_KEY=
# Global cap on generated answers per warm instance per day.
COPILOT_DAILY_LLM_BUDGET=30
# Where indexes live (default: ./index)
# COPILOT_INDEX_DIR=
# Set to "on" to make cross-encoder reranking the MCP default (measured to hurt on code; see eval/RESULTS.md)
# COPILOT_RERANK=off
